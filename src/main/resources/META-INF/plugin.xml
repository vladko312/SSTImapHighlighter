<idea-plugin>
    <id>com.sstimap.highlighter</id>
    <name>SSTImap Plugin Highlighter</name>
    <version>1.0</version>
    <vendor email="vladko312@gmail.com" url="https://github.com/vladko312/">Vladislav Korchagin</vendor>

    <description><![CDATA[
    Highlights SSTImap plugin syntax in strings.
    ]]></description>
    <change-notes><![CDATA[
    1.0: Plugin created.
    ]]></change-notes>

    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.python</depends>

    <extensions defaultExtensionNs="com.intellij">
        <annotator
            language="Python"
            implementationClass="com.sstimap.highlighter.SSTImapAnnotator"/>
        
        <colorSettingsPage implementation="com.sstimap.highlighter.SSTImapColors"/>
    </extensions>
</idea-plugin>